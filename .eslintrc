module.exports = {
    env: {
        node:   true,
        es2022: true,
    },
    extends: ['eslint:recommended'],
    parserOptions: {
        ecmaVersion: 2022,
    },
    rules: {
        // Enforce structured logging — use logger.js instead of console
        'no-console':      'error',
        // Catch leftover debug code
        'no-debugger':     'error',
        // Prefer const/let; var has function-scoped gotchas
        'no-var':          'error',
        'prefer-const':    'error',
        // Always use strict equality to avoid type coercion surprises
        'eqeqeq':          ['error', 'always'],
        // Unused variables are often a sign of incomplete refactoring;
        // leading underscore convention exempts intentional placeholders
        'no-unused-vars':  ['error', { argsIgnorePattern: '^_' }],
        // Throwing literals instead of Error objects loses the stack trace
        'no-throw-literal': 'error',
    },
};